{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "cancelled"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "phone",
    "service",
    "date"
  ]
}